@inherits LayoutComponentBase
@inject ThemeService Theme
@inject AppBootService Boot
@inject IJSRuntime Js
@inject NavigationManager Nav
@implements IDisposable

@if (!_bootResolved)
{
    <div class="splash-screen splash-pending" aria-busy="true"></div>
}
else if (!Boot.IsReady)
{
    <SplashOverlay />
}
else
{
    <div class="app-shell @(Theme.IsDark ? "theme-dark" : null)">
        <aside class="sidebar">
            <div class="brand">
                <img class="brand-mark" src="branding/icon.png" alt="@AppBrand.Name" width="40" height="40" />
                <div class="brand-text">
                    <div class="brand-name">@AppBrand.Name</div>
                    <div class="brand-sub">@AppBrand.Subtitle</div>
                </div>
            </div>
            <nav class="nav">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </NavLink>
                <NavLink class="nav-link" href="transactions">
                    <i class="bi bi-arrow-left-right"></i> Transactions
                </NavLink>
                <div class="nav-link nav-disabled" aria-disabled="true">
                    <i class="bi bi-upload"></i> Import
                </div>
                <NavLink class="nav-link" href="reports">
                    <i class="bi bi-bar-chart"></i> Reports
                </NavLink>
                <NavLink class="@PlanningClass" href="planning">
                    <i class="bi bi-clipboard-data"></i> Planning
                </NavLink>
                <NavLink class="@GoalsClass" href="goals">
                    <i class="bi bi-flag"></i> Goals
                </NavLink>
                <NavLink class="nav-link" href="forecast">
                    <i class="bi bi-graph-up-arrow"></i> Forecast
                </NavLink>
                <NavLink class="nav-link" href="settings">
                    <i class="bi bi-gear"></i> Settings
                </NavLink>
            </nav>
            <div class="sidebar-footer">
                <button type="button" class="theme-toggle" @onclick="ToggleTheme">
                    <i class="bi @(Theme.IsDark ? "bi-brightness-high" : "bi-moon-stars")"></i>
                    @(Theme.IsDark ? "Light theme" : "Dark theme")
                </button>
                <p class="drawer-quote">@AppBrand.Tagline</p>
                <p class="proto-badge">@AppBrand.VersionLabel · in-memory demo</p>
            </div>
        </aside>
        <div class="main">
            <main class="content page-appear">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private bool _bootResolved;

    private string PlanningClass
    {
        get
        {
            var path = Path();
            var selected = path.Contains("/planning") || path.EndsWith("/budget");
            return selected ? "nav-link active" : "nav-link";
        }
    }

    private string GoalsClass
    {
        get
        {
            var path = Path();
            var selected = path.Contains("/goal");
            return selected ? "nav-link active" : "nav-link";
        }
    }

    private string Path() => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        Boot.Changed += OnBootChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _bootResolved) return;

        try
        {
            var stored = await Js.InvokeAsync<string?>("ffsTheme.get");
            var dark = stored != "light";
            Theme.SetDark(dark);
            await Js.InvokeVoidAsync("ffsTheme.set", dark ? "dark" : "light");
        }
        catch (JSException) { /* ignore */ }
        catch (InvalidOperationException) { /* ignore */ }

        try
        {
            var showSplash = await Js.InvokeAsync<bool>("ffsSplash.shouldShow");
            Boot.ApplySplashCache(showSplash);
            _bootResolved = true;
            await InvokeAsync(StateHasChanged);

            if (showSplash)
            {
                await Boot.EnsureStartedAsync();
                await Js.InvokeVoidAsync("ffsSplash.markSeen");
                await Js.InvokeVoidAsync("ffsSplash.applyDocumentFlag");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
            Boot.ApplySplashCache(showSplash: false);
            _bootResolved = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleTheme()
    {
        Theme.Toggle();
        var value = Theme.IsDark ? "dark" : "light";
        try
        {
            await Js.InvokeVoidAsync("ffsTheme.set", value);
            await Js.InvokeVoidAsync("ffsTheme.save", value);
        }
        catch { /* ignore */ }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);
    private void OnBootChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Boot.Changed -= OnBootChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
