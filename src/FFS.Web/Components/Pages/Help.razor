@page "/help"
@inject HttpClient Http

<PageTitle>@AppBrand.Name · Help</PageTitle>

<PageHeader Eyebrow="Help" Title="Answers" Subtitle="Search in your own words. Close wording and small typos still find an answer." />

<label class="catalog-search help-search">
    <span class="visually-hidden">Search help</span>
    <input type="search" placeholder="Search questions…" @bind="_query" @bind:event="oninput" />
</label>

@if (_items.Count == 0 && _loaded)
{
    <p class="muted">Help could not be loaded.</p>
}
else if (Visible.Count == 0)
{
    <p class="muted">Nothing matches that search. Try a shorter word, like import or export.</p>
}
else
{
    @foreach (var item in Visible)
    {
        <article class="card help-item">
            <h3>@item.Question</h3>
            <p>@item.Answer</p>
        </article>
    }
}

@code {
    private string _query = "";
    private bool _loaded;
    private List<FaqEntry> _items = [];

    private IReadOnlyList<FaqEntry> Visible
    {
        get
        {
            var q = _query.Trim();
            if (q.Length == 0) return _items;
            return FaqSearch.Rank(_items, q).Select(h => h.Entry).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var text = await Http.GetStringAsync("data/faq.md");
            _items = FaqSearch.Parse(text);
        }
        catch
        {
            _items = [];
        }
        finally
        {
            _loaded = true;
        }
    }
}
