@page "/reports"
@inject ReportingService ReportingSvc
@inject BudgetService BudgetSvc
@inject CsvExportService Export
@inject NavigationManager Nav
@inject ThemeService Theme
@inject PaletteService Palette
@inject IFinancialDataProvider Data
@inject IJSRuntime Js
@using System.Globalization
@using System.Text.Json
@implements IDisposable
@using FFS.Domain
@using FFS.Domain.Enums

<PageTitle>@AppBrand.Name · Reports</PageTitle>

<div class="page-hero">
    <div>
        <div class="eyebrow">Reports</div>
        <h1>Analyse your numbers</h1>
        <p>Your income, spending and merchant patterns, using the same cash-flow rules as FFS Mobile.</p>
    </div>
    <div class="hero-meta">
        <DateRangePills From="_start" To="_end" />
        <button type="button" class="secondary" @onclick="DownloadExport"><i class="bi bi-download"></i> Export</button>
    </div>
</div>

<div class="chip-row inset">
    @foreach (var p in Enum.GetValues<DateRangePreset>())
    {
        <button type="button" class="chip @(_preset == p ? "active" : null)" @onclick="() => SetPreset(p)">@p.DisplayName()</button>
    }
</div>

<div class="chip-row inset">
    @foreach (var chart in _charts)
    {
        <button type="button" class="chip @(Show(chart.Id) ? "active" : null)" @onclick="() => ToggleChart(chart.Id)">@chart.Label</button>
    }
</div>

<div class="kpi-grid">
    <KpiCard Label="Income" Value="@MoneyFormat.Zar(_cash.MoneyIn)" Icon="bi-arrow-up" Tone="success"
             Delta="@_inDelta" DeltaUp="@_inUp" Caption="@($"{_cash.TransactionCount} transactions")" Clickable="true" OnClick="DrillIncome" />
    <KpiCard Label="Spending" Value="@MoneyFormat.Zar(_cash.MoneyOut)" Icon="bi-arrow-down" Tone="error"
             Delta="@_outDelta" DeltaUp="@_outUp" Caption="vs previous period" Clickable="true" OnClick="DrillSpending" />
    <KpiCard Label="Net cash flow" Value="@MoneyFormat.Zar(_cash.Net)" Icon="bi-diagram-3" Tone="neutral"
             Delta="@_netDelta" DeltaUp="@_netUp" Caption="@($"{_cash.TransactionCount} transactions")" />
</div>

@if (Show("bars") || Show("daily"))
{
<div class="grid-2">
    @if (Show("bars"))
    {
    <div class="card chart-card chart-drill">
        <div class="card-header">
            <div>
                <h3><i class="bi bi-bar-chart"></i> Income vs Spending</h3>
                <p class="muted small">Your monthly totals over the selected period. Click a bar or point to open those transactions.</p>
            </div>
            <div class="chart-styles">
                @foreach (var style in _barStyles)
                {
                    <button type="button" class="chip @(_bars == style.Id ? "active" : null)" @onclick="() => SetBars(style.Id)">@style.Label</button>
                }
            </div>
        </div>
        @if (_bars is "line" or "area")
        {
            <ApexChart @key="@($"ivs-{_bars}-{_chartKey}-{Theme.IsDark}-{Palette.Revision}")" TItem="MonthlyTrendPoint" Height="280" Options="BarsOptions()" OnClick="OnBarsPlot">
                <ApexPointSeries TItem="MonthlyTrendPoint" Items="_monthly" Name="Money In" SeriesType="@FlowSeries(_bars)"
                                 XValue="@(e => e.Month)" YValue="@(e => e.MoneyIn)" />
                <ApexPointSeries TItem="MonthlyTrendPoint" Items="_monthly" Name="Money Out" SeriesType="@FlowSeries(_bars)"
                                 XValue="@(e => e.Month)" YValue="@(e => e.MoneyOut)" />
            </ApexChart>
        }
        else
        {
            <ApexChart @key="@($"ivs-{_bars}-{_chartKey}-{Theme.IsDark}-{Palette.Revision}")" TItem="MonthlyTrendPoint" Height="280" Options="BarsOptions()" OnDataPointSelection="OnBarsPoint">
                <ApexPointSeries TItem="MonthlyTrendPoint" Items="_monthly" Name="Money In" SeriesType="SeriesType.Bar"
                                 XValue="@(e => e.Month)" YValue="@(e => e.MoneyIn)" />
                <ApexPointSeries TItem="MonthlyTrendPoint" Items="_monthly" Name="Money Out" SeriesType="SeriesType.Bar"
                                 XValue="@(e => e.Month)" YValue="@(e => e.MoneyOut)" />
            </ApexChart>
        }
    </div>
    }
    @if (Show("daily"))
    {
    <div class="card chart-card chart-drill">
        <div class="card-header">
            <div>
                <h3><i class="bi bi-activity"></i> Daily cash flow</h3>
                <p class="muted small">Your income and expenses by day. Click a point to open that day.</p>
            </div>
            <div class="chart-styles">
                @foreach (var style in _dailyStyles)
                {
                    <button type="button" class="chip @(_dailyStyle == style.Id ? "active" : null)" @onclick="() => SetDaily(style.Id)">@style.Label</button>
                }
            </div>
        </div>
        @if (_dailyStyle == "columns")
        {
            <ApexChart @key="@($"daily-{_dailyStyle}-{_chartKey}-{Theme.IsDark}-{Palette.Revision}")" TItem="DailyCashFlowPoint" Height="280" Options="DailyOptions()" OnDataPointSelection="OnDailyPoint">
                <ApexPointSeries TItem="DailyCashFlowPoint" Items="_daily" Name="Money In" SeriesType="SeriesType.Bar"
                                 XValue="@(e => e.Label)" YValue="@(e => e.MoneyIn)" />
                <ApexPointSeries TItem="DailyCashFlowPoint" Items="_daily" Name="Money Out" SeriesType="SeriesType.Bar"
                                 XValue="@(e => e.Label)" YValue="@(e => e.MoneyOut)" />
            </ApexChart>
        }
        else
        {
            <ApexChart @key="@($"daily-{_dailyStyle}-{_chartKey}-{Theme.IsDark}-{Palette.Revision}")" TItem="DailyCashFlowPoint" Height="280" Options="DailyOptions()" OnClick="OnDailyPlot">
                <ApexPointSeries TItem="DailyCashFlowPoint" Items="_daily" Name="Money In" SeriesType="@FlowSeries(_dailyStyle)"
                                 XValue="@(e => e.Label)" YValue="@(e => e.MoneyIn)" />
                <ApexPointSeries TItem="DailyCashFlowPoint" Items="_daily" Name="Money Out" SeriesType="@FlowSeries(_dailyStyle)"
                                 XValue="@(e => e.Label)" YValue="@(e => e.MoneyOut)" />
            </ApexChart>
        }
    </div>
    }
</div>
}

@if (Show("banks"))
{
<div class="card" style="margin-bottom:1rem;">
    <div class="card-header">
        <div>
            <h3><i class="bi bi-bank"></i> Spending by bank</h3>
            <p class="muted small">Your money out, grouped by your account’s institution.</p>
        </div>
    </div>
    @if (_banks.Count == 0)
    {
        <p class="muted">No spending in this period.</p>
    }
    else
    {
        @foreach (var bank in _banks)
        {
            var pct = _cash.MoneyOut <= 0 ? 0 : (bank.Total / _cash.MoneyOut) * 100;
            <div class="legend-row clickable" @onclick="() => DrillBank(bank)">
                <span class="avatar">@Initial(bank.InstitutionName)</span>
                <span class="meter-copy">
                    <span>@bank.InstitutionName</span>
                    <span class="meter-track" aria-hidden="true"><span class="meter-fill" style="width:@Meter(pct)"></span></span>
                </span>
                <span class="muted">@pct.ToString("0")%</span>
                <span class="amount out">@MoneyFormat.Zar(bank.Total)</span>
            </div>
        }
    }
</div>
}

@if (Show("category") || Show("merchants") || Show("trends"))
{
<div class="grid-3 reports-bottom">
    @if (Show("category"))
    {
    <div class="card chart-card chart-drill">
        <div class="card-header">
            <div>
                <h3><i class="bi bi-pie-chart"></i> Spending by category</h3>
                <p class="muted small">Click a slice or bar to open that category.</p>
            </div>
            <div class="chart-styles">
                @foreach (var style in _categoryStyles)
                {
                    <button type="button" class="chip @(_category == style.Id ? "active" : null)" @onclick="() => SetCategory(style.Id)">@style.Label</button>
                }
            </div>
        </div>
        @if (_byCategory.Count == 0)
        {
            <p class="muted">No spending in this period.</p>
        }
        else
        {
            <div class="donut-split">
                <ApexChart @key="@($"cat-{_category}-{_chartKey}-{Theme.IsDark}-{Palette.Revision}")" TItem="CategoryTotal" Height="@(_category == "bars" ? 260 : 200)" Options="CategoryOptions()" OnDataPointSelection="OnCategoryPoint">
                    <ApexPointSeries TItem="CategoryTotal" Items="_byCategory" Name="Spend" SeriesType="@(_category == "bars" ? SeriesType.Bar : SeriesType.Donut)"
                                     XValue="@(e => e.CategoryName)" YValue="@(e => e.Total)" />
                </ApexChart>
                <div class="legend-list">
                    @{ var i = 0; }
                    @foreach (var row in _byCategory.Take(6))
                    {
                        var pct = _cash.MoneyOut <= 0 ? 0 : (row.Total / _cash.MoneyOut) * 100;
                        <div class="legend-row clickable" @onclick="() => DrillCategory(row)">
                            <span class="swatch" style="background:@Palette.Colors.ChartAt(i)"></span>
                            <span class="meter-copy">
                                <span>@row.CategoryName</span>
                                <span class="meter-track" aria-hidden="true"><span class="meter-fill" style="width:@Meter(pct)"></span></span>
                            </span>
                            <span class="muted">@pct.ToString("0")%</span>
                            <span class="amount out">@MoneyFormat.Zar(row.Total)</span>
                        </div>
                        i++;
                    }
                </div>
            </div>
        }
    </div>
    }
    @if (Show("merchants"))
    {
    <div class="card">
        <div class="card-header">
            <div>
                <h3><i class="bi bi-shop"></i> Top merchants</h3>
                <p class="muted small">Your highest spending merchants.</p>
            </div>
        </div>
        @foreach (var m in _merchants)
        {
            var pct = _cash.MoneyOut <= 0 ? 0 : (m.Total / _cash.MoneyOut) * 100;
            <div class="legend-row clickable" @onclick="() => DrillMerchant(m.Merchant)">
                <span class="avatar">@Initial(m.Merchant)</span>
                <span class="meter-copy">
                    <span>@m.Merchant</span>
                    <span class="meter-track" aria-hidden="true"><span class="meter-fill" style="width:@Meter(pct)"></span></span>
                </span>
                <span class="muted">@pct.ToString("0")%</span>
                <span class="amount out">@MoneyFormat.Zar(m.Total)</span>
            </div>
        }
        <a class="text-link" href="@TxnUrl($"direction=MoneyOut&from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}")">View all merchants</a>
    </div>
    }
    @if (Show("trends"))
    {
    <div class="card chart-card chart-drill">
        <div class="card-header">
            <div>
                <h3><i class="bi bi-graph-up"></i> Spending trends</h3>
                <p class="muted small">Category trends over time. Click a point to open that category for that month.</p>
            </div>
            <div class="chart-styles">
                @foreach (var style in _trendStyles)
                {
                    <button type="button" class="chip @(_trends == style.Id ? "active" : null)" @onclick="() => SetTrends(style.Id)">@style.Label</button>
                }
            </div>
        </div>
        <ApexChart @key="@($"ctrend-{_trends}-{_chartKey}-{Theme.IsDark}-{Palette.Revision}")" TItem="CategoryMonthPoint" Height="260" Options="TrendOptions()" OnClick="OnTrendPlot">
            @foreach (var name in _trendCats)
            {
                var items = _catTrend.Where(x => x.CategoryName == name).ToList();
                <ApexPointSeries TItem="CategoryMonthPoint" Items="items" Name="@name" SeriesType="@(_trends == "area" ? SeriesType.Area : SeriesType.Line)"
                                 XValue="@(e => e.Month)" YValue="@(e => e.Total)" />
            }
        </ApexChart>
    </div>
    }
</div>
}

@code {
    private DateRangePreset _preset = DateRangePreset.ThisMonth;
    private int _chartKey;
    private DateTime _start;
    private DateTime _end;
    private CashFlowSummary _cash = new(0, 0, 0, 0);
    private string? _inDelta, _outDelta, _netDelta;
    private bool _inUp, _outUp, _netUp;
    private List<MonthlyTrendPoint> _monthly = [];
    private List<DailyCashFlowPoint> _daily = [];
    private List<CategoryTotal> _byCategory = [];
    private List<MerchantTotal> _merchants = [];
    private List<InstitutionTotal> _banks = [];
    private List<CategoryMonthPoint> _catTrend = [];
    private List<string> _trendCats = [];
    private readonly HashSet<string> _hidden = [];
    private string _bars = "columns";
    private string _dailyStyle = "area";
    private string _category = "donut";
    private string _trends = "line";
    private bool _stylesLoaded;
    private static readonly (string Id, string Label)[] _barStyles = [("columns", "Columns"), ("stacked", "Stacked"), ("line", "Line"), ("area", "Area")];
    private static readonly (string Id, string Label)[] _dailyStyles = [("area", "Area"), ("line", "Line"), ("columns", "Columns")];
    private static readonly (string Id, string Label)[] _categoryStyles = [("donut", "Donut"), ("bars", "Bars")];
    private static readonly (string Id, string Label)[] _trendStyles = [("line", "Line"), ("area", "Area")];
    private static readonly JsonSerializerOptions StyleJson = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, PropertyNameCaseInsensitive = true };
    private static readonly (string Id, string Label)[] _charts =
    [
        ("bars", "Income vs spending"),
        ("daily", "Daily cash flow"),
        ("banks", "Banks"),
        ("category", "Categories"),
        ("merchants", "Merchants"),
        ("trends", "Trends")
    ];

    private bool Show(string id) => !_hidden.Contains(id);

    private void ToggleChart(string id)
    {
        if (!_hidden.Add(id))
            _hidden.Remove(id);
    }

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        Palette.Changed += OnThemeChanged;
        Reload();
    }

    private void OnThemeChanged()
    {
        _chartKey++;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _stylesLoaded) return;
        _stylesLoaded = true;
        try
        {
            var json = await Js.InvokeAsync<string?>("ffsReportStyles.get");
            if (string.IsNullOrWhiteSpace(json)) return;
            var saved = JsonSerializer.Deserialize<ReportStylePrefs>(json, StyleJson);
            if (saved is null) return;
            _bars = Pick(saved.Bars, _barStyles, _bars);
            _dailyStyle = Pick(saved.Daily, _dailyStyles, _dailyStyle);
            _category = Pick(saved.Category, _categoryStyles, _category);
            _trends = Pick(saved.Trends, _trendStyles, _trends);
            StateHasChanged();
        }
        catch { /* keep the defaults */ }
    }

    private static string Pick(string? value, (string Id, string Label)[] allowed, string fallback) =>
        allowed.Any(s => s.Id == value) ? value! : fallback;

    private Task SetBars(string id) => SaveStyle(() => _bars = id);
    private Task SetDaily(string id) => SaveStyle(() => _dailyStyle = id);
    private Task SetCategory(string id) => SaveStyle(() => _category = id);
    private Task SetTrends(string id) => SaveStyle(() => _trends = id);

    private async Task SaveStyle(Action apply)
    {
        apply();
        _chartKey++;
        try
        {
            var json = JsonSerializer.Serialize(new ReportStylePrefs(_bars, _dailyStyle, _category, _trends), StyleJson);
            await Js.InvokeVoidAsync("ffsReportStyles.save", json);
        }
        catch { /* the choice still applies for this visit */ }
    }

    private static SeriesType FlowSeries(string style) =>
        style == "area" ? SeriesType.Area : SeriesType.Line;

    private ApexChartOptions<MonthlyTrendPoint> BarsOptions() =>
        _bars switch
        {
            "area" => ChartThemeOptions.Create<MonthlyTrendPoint>(Theme.IsDark, ChartThemeOptions.ApplyCashFlowArea),
            "line" => ChartThemeOptions.Create<MonthlyTrendPoint>(Theme.IsDark, ChartThemeOptions.ApplyCashFlowLine),
            _ => ChartThemeOptions.Create<MonthlyTrendPoint>(Theme.IsDark, o => ChartThemeOptions.ApplyColumns(o, _bars == "stacked"))
        };

    private ApexChartOptions<DailyCashFlowPoint> DailyOptions() =>
        _dailyStyle switch
        {
            "columns" => ChartThemeOptions.Create<DailyCashFlowPoint>(Theme.IsDark, o => ChartThemeOptions.ApplyColumns(o, false)),
            "line" => ChartThemeOptions.Create<DailyCashFlowPoint>(Theme.IsDark, ChartThemeOptions.ApplyCashFlowLine),
            _ => ChartThemeOptions.Create<DailyCashFlowPoint>(Theme.IsDark, ChartThemeOptions.ApplyCashFlowArea)
        };

    private ApexChartOptions<CategoryTotal> CategoryOptions() =>
        _category == "bars"
            ? ChartThemeOptions.Create<CategoryTotal>(Theme.IsDark, ChartThemeOptions.ApplyCategoryBars)
            : ChartThemeOptions.Create<CategoryTotal>(Theme.IsDark, o => ChartThemeOptions.ApplyDonut(o, "Total spent"));

    private ApexChartOptions<CategoryMonthPoint> TrendOptions() =>
        ChartThemeOptions.Create<CategoryMonthPoint>(Theme.IsDark, _trends == "area" ? ChartThemeOptions.ApplyCategoryArea : ChartThemeOptions.ApplyCategoryLines);

    private void OnBarsPoint(SelectedData<MonthlyTrendPoint> selected) =>
        ChartNavigation.OpenMonth(Nav, _monthly, selected.DataPointIndex, selected.SeriesIndex);

    private async Task OnBarsPlot(SelectedData<MonthlyTrendPoint> _)
    {
        var hit = await Js.InvokeAsync<ChartHit>("ffsReadChartHit");
        ChartNavigation.OpenMonth(Nav, _monthly, hit.Index, hit.Series);
    }

    private void OnDailyPoint(SelectedData<DailyCashFlowPoint> selected) =>
        ChartNavigation.OpenDay(Nav, _daily, selected.DataPointIndex, selected.SeriesIndex);

    private async Task OnDailyPlot(SelectedData<DailyCashFlowPoint> _)
    {
        var hit = await Js.InvokeAsync<ChartHit>("ffsReadChartHit");
        ChartNavigation.OpenDay(Nav, _daily, hit.Index, hit.Series);
    }

    private void OnCategoryPoint(SelectedData<CategoryTotal> selected)
    {
        var index = selected.DataPointIndex >= 0 ? selected.DataPointIndex : selected.SeriesIndex;
        if (index < 0 || index >= _byCategory.Count) return;
        DrillCategory(_byCategory[index]);
    }

    private async Task OnTrendPlot(SelectedData<CategoryMonthPoint> _)
    {
        var hit = await Js.InvokeAsync<ChartHit>("ffsReadChartHit");
        if (hit.Index < 0) return;
        if (hit.Series >= 0 && hit.Series < _trendCats.Count)
        {
            DrillTrend(_trendCats[hit.Series], hit.Index);
            return;
        }

        if (_trendCats.Count == 0) return;
        var items = _catTrend.Where(x => x.CategoryName == _trendCats[0]).ToList();
        if (hit.Index >= items.Count) return;
        OpenMonthSpend(items[hit.Index].Month, categoryId: null);
    }

    private void DrillTrend(string name, int index)
    {
        var items = _catTrend.Where(x => x.CategoryName == name).ToList();
        if (index < 0 || index >= items.Count) return;
        var category = Data.Categories.FirstOrDefault(c => c.Name == name);
        OpenMonthSpend(items[index].Month, category?.Id);
    }

    private void OpenMonthSpend(string label, long? categoryId)
    {
        if (!TryMonth(label, out var start)) return;
        Nav.NavigateTo(ChartNavigation.Url(start, start.AddMonths(1).AddDays(-1), series: 1, categoryId));
    }

    private static bool TryMonth(string label, out DateTime start)
    {
        if (DateTime.TryParseExact(label, "MMM yyyy", CultureInfo.CurrentCulture, DateTimeStyles.None, out start))
            return true;
        return DateTime.TryParseExact(label, "MMM yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out start);
    }

    private sealed record ReportStylePrefs(string Bars, string Daily, string Category, string Trends);

    private static string Meter(decimal pct) =>
        $"{Math.Clamp(pct, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";

    private void SetPreset(DateRangePreset preset)
    {
        _preset = preset;
        Reload();
    }

    private void Reload()
    {
        (_start, _end) = _preset.Resolve();
        _cash = ReportingSvc.CashFlow(_start, _end);
        var days = (_end.Date - _start.Date).Days + 1;
        var prev = ReportingSvc.CashFlow(_start.AddDays(-days), _start.AddDays(-1));
        var id = CashFlowRules.VsLastDelta(_cash.MoneyIn, prev.MoneyIn);
        var od = CashFlowRules.VsLastDelta(_cash.MoneyOut, prev.MoneyOut);
        var nd = CashFlowRules.VsLastDelta(_cash.Net, prev.Net);
        _inDelta = id?.Text; _inUp = id?.Change >= 0;
        _outDelta = od?.Text; _outUp = od?.Change >= 0;
        _netDelta = nd?.Text; _netUp = nd?.Change >= 0;
        _monthly = ReportingSvc.MonthlyTrend(_start, _end).ToList();
        _daily = ReportingSvc.PeriodCashFlow(_start, _end).ToList();
        _byCategory = ReportingSvc.SpendingByCategory(_start, _end).ToList();
        _merchants = ReportingSvc.TopMerchants(_start, _end, 5).ToList();
        _banks = ReportingSvc.SpendingByInstitution(_start, _end).ToList();
        _catTrend = ReportingSvc.SpendingCategoryTrend(_start, _end).ToList();
        _trendCats = _catTrend.Select(x => x.CategoryName).Distinct().ToList();
        _chartKey++;
    }

    private void DrillIncome() =>
        Nav.NavigateTo(TxnUrl($"direction=MoneyIn&from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}"));

    private void DrillSpending() =>
        Nav.NavigateTo(TxnUrl($"direction=MoneyOut&from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}"));

    private void DrillCategory(CategoryTotal row)
    {
        var q = $"from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}&direction=MoneyOut";
        if (row.CategoryId is long id) q += $"&categoryId={id}";
        Nav.NavigateTo(TxnUrl(q));
    }

    private void DrillMerchant(string merchant) =>
        Nav.NavigateTo(TxnUrl($"merchant={Uri.EscapeDataString(merchant)}&from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}&direction=MoneyOut"));

    private void DrillBank(InstitutionTotal bank)
    {
        var account = bank.AccountIds.Count == 1 ? $"&accountId={bank.AccountIds[0]}" : "";
        var search = bank.AccountIds.Count == 1 ? "" : $"&search={Uri.EscapeDataString(bank.InstitutionName)}";
        Nav.NavigateTo(TxnUrl($"direction=MoneyOut&from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}{account}{search}"));
    }

    private async Task DownloadExport()
    {
        var csv = Export.ExportWorkbook();
        await Js.InvokeVoidAsync("ffsDownload", "ffs-export.csv", csv);
    }

    private static string TxnUrl(string query) => $"transactions?{query}";
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Palette.Changed -= OnThemeChanged;
    }
}
