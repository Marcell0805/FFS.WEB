@page "/reports"
@inject ReportingService ReportingSvc
@inject NavigationManager Nav
@inject ThemeService Theme
@implements IDisposable

<PageTitle>@AppBrand.Name · Reports</PageTitle>

<div class="page-hero">
    <div class="eyebrow">Reports</div>
    <h1>Analyse the numbers</h1>
    <p>Income, spending and merchant patterns using the same cash-flow rules as FFS Mobile.</p>
</div>

<div class="preset-row">
    @foreach (var p in Enum.GetValues<DateRangePreset>())
    {
        <button type="button" class="@(_preset == p ? "active" : null)" @onclick="() => SetPreset(p)">@p.DisplayName()</button>
    }
</div>
<p class="muted small" style="margin-top:-0.5rem; margin-bottom:1rem;">
    Showing @_start.ToString("dd MMM yyyy") → @_end.ToString("dd MMM yyyy")
</p>

<div class="kpi-grid">
    <div class="kpi-card clickable-card" @onclick="DrillIncome">
        <div class="kpi-label">Income</div>
        <div class="kpi-value positive">@MoneyFormat.Zar(_cash.MoneyIn)</div>
        <div class="muted small">Click to view Money In →</div>
    </div>
    <div class="kpi-card clickable-card" @onclick="DrillSpending">
        <div class="kpi-label">Spending</div>
        <div class="kpi-value negative">@MoneyFormat.Zar(_cash.MoneyOut)</div>
        <div class="muted small">Click to view Money Out →</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Net</div>
        <div class="kpi-value @(_cash.Net >= 0 ? "positive" : "negative")">@MoneyFormat.Zar(_cash.Net)</div>
    </div>
</div>

<div class="grid-2">
    <div class="card">
        <h3>Income vs Spending</h3>
        <ApexChart @key="@($"ivs-{_chartKey}-{Theme.IsDark}")" TItem="NamedValue" Height="280" Options="DarkAwareOptions<NamedValue>()">
            <ApexPointSeries TItem="NamedValue"
                             Items="_incomeVsSpend"
                             Name="Total"
                             SeriesType="SeriesType.Bar"
                             XValue="@(e => e.Name)"
                             YValue="@(e => e.Value)" />
        </ApexChart>
    </div>
    <div class="card">
        <h3>Daily / period cash flow</h3>
        <ApexChart @key="@($"daily-{_chartKey}-{Theme.IsDark}")" TItem="DailyCashFlowPoint" Height="280" Options="DarkAwareOptions<DailyCashFlowPoint>()">
            <ApexPointSeries TItem="DailyCashFlowPoint"
                             Items="_daily"
                             Name="Money In"
                             SeriesType="SeriesType.Line"
                             XValue="@(e => e.Label)"
                             YValue="@(e => e.MoneyIn)" />
            <ApexPointSeries TItem="DailyCashFlowPoint"
                             Items="_daily"
                             Name="Money Out"
                             SeriesType="SeriesType.Line"
                             XValue="@(e => e.Label)"
                             YValue="@(e => e.MoneyOut)" />
        </ApexChart>
    </div>
</div>

<div class="grid-2">
    <div class="card">
        <h3>Monthly income / spending trend</h3>
        <ApexChart @key="@($"monthly-{_chartKey}-{Theme.IsDark}")" TItem="MonthlyTrendPoint" Height="300" Options="DarkAwareOptions<MonthlyTrendPoint>()">
            <ApexPointSeries TItem="MonthlyTrendPoint"
                             Items="_monthly"
                             Name="Money In"
                             SeriesType="SeriesType.Bar"
                             XValue="@(e => e.Month)"
                             YValue="@(e => e.MoneyIn)" />
            <ApexPointSeries TItem="MonthlyTrendPoint"
                             Items="_monthly"
                             Name="Money Out"
                             SeriesType="SeriesType.Bar"
                             XValue="@(e => e.Month)"
                             YValue="@(e => e.MoneyOut)" />
        </ApexChart>
    </div>
    <div class="card">
        <h3>Spending by category</h3>
        <p class="muted small">Click a category row below the chart to drill into transactions.</p>
        <ApexChart @key="@($"cat-{_chartKey}-{Theme.IsDark}")" TItem="CategoryTotal" Height="260" Options="DarkAwareOptions<CategoryTotal>()">
            <ApexPointSeries TItem="CategoryTotal"
                             Items="_byCategory"
                             Name="Spend"
                             SeriesType="SeriesType.Donut"
                             XValue="@(e => e.CategoryName)"
                             YValue="@(e => e.Total)" />
        </ApexChart>
        @foreach (var row in _byCategory.Take(8))
        {
            <div class="list-row clickable" @onclick="() => DrillCategory(row)">
                <span>@row.CategoryName</span>
                <span class="amount out">@MoneyFormat.Zar(row.Total)</span>
            </div>
        }
    </div>
</div>

<div class="card" style="margin-top:1rem;">
    <h3>Top merchants</h3>
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Merchant</th>
                    <th>Top category</th>
                    <th>Txns</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _merchants)
                {
                    <tr class="clickable" @onclick="() => DrillMerchant(m.Merchant)">
                        <td>@m.Merchant</td>
                        <td>@(m.TopCategoryName ?? "—")</td>
                        <td>@m.TransactionCount</td>
                        <td class="amount out">@MoneyFormat.Zar(m.Total)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private DateRangePreset _preset = DateRangePreset.Last3Months;
    private int _chartKey;
    private DateTime _start;
    private DateTime _end;
    private CashFlowSummary _cash = new(0, 0, 0, 0);
    private List<DailyCashFlowPoint> _daily = [];
    private List<MonthlyTrendPoint> _monthly = [];
    private List<CategoryTotal> _byCategory = [];
    private List<MerchantTotal> _merchants = [];
    private List<NamedValue> _incomeVsSpend = [];

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        Reload();
    }

    private void OnThemeChanged()
    {
        _chartKey++;
        InvokeAsync(StateHasChanged);
    }

    private ApexChartOptions<T> DarkAwareOptions<T>() where T : class =>
        ChartThemeOptions.Create<T>(Theme.IsDark);

    private void SetPreset(DateRangePreset preset)
    {
        _preset = preset;
        Reload();
    }

    private void Reload()
    {
        (_start, _end) = _preset.Resolve();
        _cash = ReportingSvc.CashFlow(_start, _end);
        _daily = ReportingSvc.PeriodCashFlow(_start, _end).ToList();
        _monthly = ReportingSvc.MonthlyTrend(_start, _end).ToList();
        _byCategory = ReportingSvc.SpendingByCategory(_start, _end).ToList();
        _merchants = ReportingSvc.TopMerchants(_start, _end, 8).ToList();
        _incomeVsSpend =
        [
            new("Income", _cash.MoneyIn),
            new("Spending", _cash.MoneyOut)
        ];
        _chartKey++;
    }

    private void DrillIncome() =>
        Nav.NavigateTo(TxnUrl($"direction=MoneyIn&from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}"));

    private void DrillSpending() =>
        Nav.NavigateTo(TxnUrl($"direction=MoneyOut&from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}"));

    private void DrillCategory(CategoryTotal row)
    {
        var q = $"from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}&direction=MoneyOut";
        if (row.CategoryId is long id) q += $"&categoryId={id}";
        else q += $"&search={Uri.EscapeDataString(row.CategoryName)}";
        Nav.NavigateTo(TxnUrl(q));
    }

    private void DrillMerchant(string merchant) =>
        Nav.NavigateTo(TxnUrl($"merchant={Uri.EscapeDataString(merchant)}&from={_start:yyyy-MM-dd}&to={_end:yyyy-MM-dd}&direction=MoneyOut"));

    private static string TxnUrl(string query) => $"transactions?{query}";

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
