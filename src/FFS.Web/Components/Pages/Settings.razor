@page "/settings"
@inject ThemeService Theme
@inject PaletteService Palette
@inject IFinancialDataProvider Data
@inject CsvExportService Export
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>@AppBrand.Name · Settings</PageTitle>

<PageHeader Eyebrow="Settings" Title="Settings" Subtitle="Accounts, appearance, and the pages that explain the app.">
    <span class="version-badge">@AppBrand.VersionLabel</span>
</PageHeader>

<section class="settings-group">
    <h3>Accounts &amp; data</h3>
    <div class="settings-card">
        <a class="settings-row buttonish" href="accounts">
            <span class="settings-icon accent"><i class="bi bi-bank"></i></span>
            <span class="settings-copy">
                <strong>Accounts</strong>
                <span class="muted small">@Data.Accounts.Count(a => a.IsActive) active accounts</span>
            </span>
            <i class="bi bi-chevron-right settings-chev"></i>
        </a>
        <div class="settings-row">
            <span class="settings-icon success"><i class="bi bi-tags"></i></span>
            <span class="settings-copy">
                <strong>Categories</strong>
                <span class="muted small">@Data.Categories.Count(c => c.IsActive) categories</span>
            </span>
        </div>
        <div class="settings-row disabled">
            <span class="settings-icon muted-icon"><i class="bi bi-upload"></i></span>
            <span class="settings-copy">
                <strong>Import</strong>
                <span class="muted small">CSV and PDF import stays on the phone</span>
            </span>
        </div>
        <button type="button" class="settings-row buttonish" @onclick="DownloadExport">
            <span class="settings-icon accent"><i class="bi bi-download"></i></span>
            <span class="settings-copy">
                <strong>Export</strong>
                <span class="muted small">Transactions plus budget tables</span>
            </span>
        </button>
    </div>
</section>

<section class="settings-group">
    <h3>Appearance</h3>
    <div class="settings-card">
        <button type="button" class="settings-row buttonish" @onclick="ToggleTheme">
            <span class="settings-icon accent"><i class="bi @(Theme.IsDark ? "bi-sun" : "bi-moon-stars")"></i></span>
            <span class="settings-copy">
                <strong>Dark mode</strong>
                <span class="muted small">@(Theme.IsDark ? "On" : "Off")</span>
            </span>
        </button>
        <div class="settings-row">
            <span class="settings-icon muted-icon"><i class="bi bi-palette"></i></span>
            <span class="settings-copy">
                <strong>Colors</strong>
                <span class="muted small">Try colors, shadows, and chart packages on the <a href="test">Test</a> page.</span>
            </span>
        </div>
    </div>
</section>

<section class="settings-group">
    <h3>About</h3>
    <div class="settings-card">
        <a class="settings-row buttonish" href="about">
            <span class="settings-icon accent"><i class="bi bi-info-circle"></i></span>
            <span class="settings-copy">
                <strong>About @AppBrand.Name</strong>
                <span class="muted small">@AppBrand.Tagline</span>
            </span>
            <i class="bi bi-chevron-right settings-chev"></i>
        </a>
        <a class="settings-row buttonish" href="@PrivacyUrl" target="_blank" rel="noopener noreferrer">
            <span class="settings-icon accent"><i class="bi bi-shield-check"></i></span>
            <span class="settings-copy">
                <strong>Privacy</strong>
                <span class="muted small">How the phone app stores your data</span>
            </span>
            <i class="bi bi-box-arrow-up-right settings-chev"></i>
        </a>
        <a class="settings-row buttonish" href="@TermsUrl" target="_blank" rel="noopener noreferrer">
            <span class="settings-icon accent"><i class="bi bi-file-text"></i></span>
            <span class="settings-copy">
                <strong>Terms</strong>
                <span class="muted small">Terms of use</span>
            </span>
            <i class="bi bi-box-arrow-up-right settings-chev"></i>
        </a>
        <a class="settings-row buttonish" href="help">
            <span class="settings-icon accent"><i class="bi bi-question-circle"></i></span>
            <span class="settings-copy">
                <strong>Help</strong>
                <span class="muted small">Search the answers</span>
            </span>
            <i class="bi bi-chevron-right settings-chev"></i>
        </a>
    </div>
</section>

<section class="settings-group">
    <h3>Test</h3>
    <div class="settings-card">
        <a class="settings-row buttonish" href="test">
            <span class="settings-icon muted-icon"><i class="bi bi-wrench"></i></span>
            <span class="settings-copy">
                <strong>Demo tools</strong>
                <span class="muted small">Reload sample money, add a transaction, or clear the ledger</span>
            </span>
            <i class="bi bi-chevron-right settings-chev"></i>
        </a>
    </div>
</section>

@code {
    private const string PrivacyUrl = "https://marcell0805.github.io/the-foxs-den-doc/privacy/ffs.html#privacy";
    private const string TermsUrl = "https://marcell0805.github.io/the-foxs-den-doc/privacy/ffs.html#terms";

    protected override void OnInitialized() => Theme.Changed += OnTheme;

    private void OnTheme() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnTheme;

    private async Task ToggleTheme()
    {
        Theme.Toggle();
        var value = Theme.IsDark ? "dark" : "light";
        try
        {
            await Js.InvokeVoidAsync("ffsTheme.set", value);
            await Js.InvokeVoidAsync("ffsTheme.save", value);
            await Js.InvokeVoidAsync("ffsPalette.apply", Palette.Colors, Theme.IsDark);
        }
        catch { /* ignore */ }
    }

    private async Task DownloadExport()
    {
        var csv = Export.ExportWorkbook();
        await Js.InvokeVoidAsync("ffsDownload", "ffs-export.csv", csv);
    }

}
