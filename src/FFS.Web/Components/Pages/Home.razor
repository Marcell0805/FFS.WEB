@page "/"
@inject DashboardService DashboardSvc
@inject ReportingService ReportingSvc
@inject IFinancialDataProvider Data
@inject NavigationManager Nav
@inject ThemeService Theme
@implements IDisposable
@using FFS.Domain
@using FFS.Domain.Enums

<PageTitle>@AppBrand.Name · Home</PageTitle>

@{
    var vm = DashboardSvc.GetDashboard();
    var cash = vm.ThisMonthCashFlow;
    var prev = vm.PreviousPeriodCashFlow;
    var showCompare = prev.TransactionCount > 0;
    var (monthStart, monthEnd) = DateRangePreset.ThisMonth.Resolve();
    var needs = vm.Budget.Buckets.FirstOrDefault(b => b.Bucket == BudgetBucketKind.Needs);
    var wants = vm.Budget.Buckets.FirstOrDefault(b => b.Bucket == BudgetBucketKind.Wants);
    var savings = vm.Budget.Buckets.FirstOrDefault(b => b.Bucket == BudgetBucketKind.Savings);
    var hasBudget = vm.Budget.Buckets.Count > 0 && vm.Budget.Buckets.Sum(b => b.Planned) > 0;
    var inDelta = showCompare ? CashFlowRules.VsLastDelta(cash.MoneyIn, prev.MoneyIn) : null;
    var outDelta = showCompare ? CashFlowRules.VsLastDelta(cash.MoneyOut, prev.MoneyOut) : null;
    var netDelta = showCompare ? CashFlowRules.VsLastDelta(cash.Net, prev.Net) : null;
}

<div class="page-hero">
    <div>
        <h1>@Greeting()</h1>
        <p>Here’s your financial overview for @monthStart.ToString("MMMM yyyy").</p>
    </div>
    <div class="hero-meta">
        <span class="pill"><i class="bi bi-calendar3"></i> @monthStart.ToString("d MMM yyyy") – @monthEnd.ToString("d MMM yyyy")</span>
    </div>
</div>

<div class="kpi-grid">
    <KpiCard Label="Money in" Value="@MoneyFormat.Zar(cash.MoneyIn)" Icon="bi-arrow-up" Tone="success"
             Delta="@(inDelta?.Text)" DeltaUp="@(inDelta?.Change >= 0)"
             Caption="@($"{cash.TransactionCount} transactions")" Clickable="true" OnClick="DrillMoneyIn" />
    <KpiCard Label="Money out" Value="@MoneyFormat.Zar(cash.MoneyOut)" Icon="bi-arrow-down" Tone="error"
             Delta="@(outDelta?.Text)" DeltaUp="@(outDelta?.Change >= 0)"
             Caption="@(showCompare ? "vs last month" : "This month")" Clickable="true" OnClick="DrillMoneyOut" />
    <KpiCard Label="Net cash flow" Value="@MoneyFormat.Zar(cash.Net)" Icon="bi-bar-chart" Tone="accent"
             Delta="@(netDelta?.Text)" DeltaUp="@(netDelta?.Change >= 0)"
             Caption="@(cash.Net >= 0 ? "You're cash positive this month." : "Cash negative this month.")"
             Clickable="true" OnClick="DrillThisMonth" />
</div>

<div class="grid-2">
    <div class="card">
        <div class="card-header">
            <div>
                <h3><i class="bi bi-activity"></i> Cash flow trend</h3>
                <p class="muted small">Income vs expenses over the last 6 months.</p>
            </div>
            <span class="pill quiet">Last 6 months</span>
        </div>
        <ApexChart @key="@($"home-trend-{Theme.IsDark}")" TItem="MonthlyTrendPoint" Height="260" Options="_trendOptions">
            <ApexPointSeries TItem="MonthlyTrendPoint" Items="vm.CashFlowTrend" Name="Money In" SeriesType="SeriesType.Line"
                             XValue="@(e => e.Month)" YValue="@(e => e.MoneyIn)" />
            <ApexPointSeries TItem="MonthlyTrendPoint" Items="vm.CashFlowTrend" Name="Money Out" SeriesType="SeriesType.Line"
                             XValue="@(e => e.Month)" YValue="@(e => e.MoneyOut)" />
        </ApexChart>
    </div>
    <div class="card">
        <div class="card-header">
            <div>
                <h3><i class="bi bi-pie-chart"></i> Spending by category</h3>
            </div>
            <span class="pill quiet">This month</span>
        </div>
        @if (vm.TopSpending.Count == 0)
        {
            <p class="muted">No spending yet this month.</p>
        }
        else
        {
            <div class="donut-split">
                <ApexChart @key="@($"home-donut-{Theme.IsDark}")" TItem="CategoryTotal" Height="220" Options="_donutOptions">
                    <ApexPointSeries TItem="CategoryTotal" Items="vm.TopSpending" Name="Spend" SeriesType="SeriesType.Donut"
                                     XValue="@(e => e.CategoryName)" YValue="@(e => e.Total)" />
                </ApexChart>
                <div class="legend-list">
                    @{ var i = 0; }
                    @foreach (var row in vm.TopSpending)
                    {
                        var pct = cash.MoneyOut <= 0 ? 0 : (row.Total / cash.MoneyOut) * 100;
                        <div class="legend-row clickable" @onclick="() => DrillCategory(row, monthStart, monthEnd)">
                            <span class="swatch s-@i"></span>
                            <span>@row.CategoryName</span>
                            <span class="muted">@pct.ToString("0")%</span>
                            <span class="amount out">@MoneyFormat.Zar(row.Total)</span>
                        </div>
                        i++;
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="grid-3">
    <div class="card">
        <div class="card-header">
            <h3><i class="bi bi-bullseye"></i> Budget snapshot</h3>
            <a class="text-link" href="planning">View planning →</a>
        </div>
        @if (!hasBudget)
        {
            <p>Create a Needs / Wants / Savings budget</p>
        }
        else
        {
            @foreach (var b in new[] { needs, wants, savings })
            {
                if (b is null) continue;
                var used = b.Planned <= 0 ? 0 : Math.Clamp((double)(b.Actual / b.Planned) * 100, 0, 100);
                <div class="snap-row">
                    <span>@b.Bucket</span>
                    <div class="progress slim"><span style="width:@used.ToString("0.##")%"></span></div>
                    <span class="muted small">@used.ToString("0")% · @MoneyFormat.ZarCompact(b.Actual) / @MoneyFormat.ZarCompact(b.Planned)</span>
                </div>
            }
        }
    </div>
    <div class="card">
        <div class="card-header">
            <h3><i class="bi bi-flag"></i> Active goals</h3>
            <a class="text-link" href="goals">View goals →</a>
        </div>
        @foreach (var g in vm.Goals.Take(3))
        {
            var pct = g.Goal.Progress * 100;
            <div class="snap-row clickable" @onclick="() => OpenGoal(g.Goal.Id)">
                <span>@g.Goal.Name</span>
                <div class="progress slim"><span style="width:@pct.ToString("0.##")%"></span></div>
                <span class="muted small">@pct.ToString("0")% · @MoneyFormat.ZarCompact(g.Goal.CurrentAmount) / @MoneyFormat.ZarCompact(g.Goal.TargetAmount)</span>
            </div>
        }
        @if (vm.Goals.Count == 0)
        {
            <p class="muted">No active goals yet. Add one under Planning.</p>
        }
    </div>
    <div class="card">
        <div class="card-header">
            <h3><i class="bi bi-bank"></i> Accounts</h3>
            <a class="text-link" href="transactions">View all →</a>
        </div>
        @foreach (var a in Data.Accounts.Where(x => x.IsActive))
        {
            var bal = ReportingSvc.AccountBalance(a.Id);
            <div class="list-row clickable" @onclick="() => OpenAccount(a.Id)">
                <div>
                    <div>@a.Name</div>
                    <div class="muted small">@a.InstitutionName · @a.AccountType</div>
                </div>
                <span class="amount @(bal >= 0 ? "in" : "out")">@MoneyFormat.Zar(bal)</span>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="bi bi-clock-history"></i> Recent transactions</h3>
        <a class="text-link" href="transactions">View all →</a>
    </div>
    <div class="table-wrap">
        <table class="data dense">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Merchant</th>
                    <th>Category</th>
                    <th>Account</th>
                    <th>Direction</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in vm.RecentTransactions)
                {
                    var cat = Data.Categories.FirstOrDefault(c => c.Id == t.CategoryId);
                    var acc = Data.Accounts.FirstOrDefault(a => a.Id == t.AccountId);
                    <tr class="clickable" @onclick="() => OpenTxn(t.Id)">
                        <td>@t.TransactionDate.ToString("d MMM yyyy")</td>
                        <td>@t.Merchant</td>
                        <td>@(cat?.Name ?? "—")</td>
                        <td>@(acc?.Name ?? "—")</td>
                        <td><span class="dir @t.Direction.ToString().ToLowerInvariant()">@LabelDir(t.Direction)</span></td>
                        <td class="amount @CssAmount(t.Direction)">@Signed(t)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private ApexChartOptions<MonthlyTrendPoint> _trendOptions = null!;
    private ApexChartOptions<CategoryTotal> _donutOptions = null!;

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        RebuildCharts();
    }

    private void OnThemeChanged()
    {
        RebuildCharts();
        InvokeAsync(StateHasChanged);
    }

    private void RebuildCharts()
    {
        _trendOptions = ChartThemeOptions.Create<MonthlyTrendPoint>(Theme.IsDark, o =>
        {
            o.Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 };
            o.DataLabels = new DataLabels { Enabled = false };
            o.Colors = ["#2dd4bf", "#fb7185"];
            o.Legend!.Position = LegendPosition.Bottom;
        });
        _donutOptions = ChartThemeOptions.Create<CategoryTotal>(Theme.IsDark, o =>
        {
            if (o.PlotOptions?.Pie?.Donut?.Labels?.Total is { } total)
            {
                total.Show = true;
                total.Label = "Total spent";
            }
            o.Legend = new Legend { Show = false };
        });
    }

    private void DrillMoneyIn()
    {
        var (start, end) = DateRangePreset.ThisMonth.Resolve();
        Nav.NavigateTo($"transactions?direction=MoneyIn&from={start:yyyy-MM-dd}&to={end:yyyy-MM-dd}");
    }

    private void DrillMoneyOut()
    {
        var (start, end) = DateRangePreset.ThisMonth.Resolve();
        Nav.NavigateTo($"transactions?direction=MoneyOut&from={start:yyyy-MM-dd}&to={end:yyyy-MM-dd}");
    }

    private void DrillThisMonth()
    {
        var (start, end) = DateRangePreset.ThisMonth.Resolve();
        Nav.NavigateTo($"transactions?from={start:yyyy-MM-dd}&to={end:yyyy-MM-dd}");
    }

    private void DrillCategory(CategoryTotal row, DateTime start, DateTime end)
    {
        var q = $"from={start:yyyy-MM-dd}&to={end:yyyy-MM-dd}&direction=MoneyOut";
        if (row.CategoryId is long id) q += $"&categoryId={id}";
        Nav.NavigateTo($"transactions?{q}");
    }

    private void OpenGoal(long id) => Nav.NavigateTo($"goals/{id}");
    private void OpenAccount(long id) => Nav.NavigateTo($"transactions?accountId={id}");
    private void OpenTxn(long id) => Nav.NavigateTo($"transactions?open={id}");

    private static string Greeting()
    {
        var hour = DateTime.Now.Hour;
        return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    }

    private static string LabelDir(MoneyDirection d) => d switch
    {
        MoneyDirection.MoneyIn => "Money in",
        MoneyDirection.MoneyOut => "Money out",
        _ => "Transfer"
    };

    private static string CssAmount(MoneyDirection d) => d switch
    {
        MoneyDirection.MoneyIn => "in",
        MoneyDirection.MoneyOut => "out",
        _ => "transfer"
    };

    private static string Signed(FFS.Domain.Entities.Transaction t) => t.Direction switch
    {
        MoneyDirection.MoneyIn => $"+{MoneyFormat.Zar(t.Amount)}",
        MoneyDirection.MoneyOut => $"-{MoneyFormat.Zar(t.Amount)}",
        _ => MoneyFormat.Zar(t.Amount)
    };

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
